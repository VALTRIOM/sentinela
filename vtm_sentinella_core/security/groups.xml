<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sentinella" model="ir.module.category">
            <field name="name">Sentinella</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_sentinella_user" model="res.groups">
            <field name="name">Usuario Sentinella</field>
            <field name="category_id" ref="module_category_sentinella"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_sentinella_manager" model="res.groups">
            <field name="name">Gerente Sentinella</field>
            <field name="category_id" ref="module_category_sentinella"/>
            <field name="implied_ids" eval="[(4, ref('vtm_sentinella_core.group_sentinella_user'))]"/>
        </record>
    </data>
</odoo>
