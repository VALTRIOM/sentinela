<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sentinella_alert_list" model="ir.ui.view">
            <field name="name">sentinella.alert.list</field>
            <field name="model">sentinella.alert</field>
            <field name="arch" type="xml">
                <tree string="Alertas Sentinella" default_order="date desc, state desc" decoration-danger="state=='rojo'" decoration-warning="state=='amarillo'">
                    <field name="date"/>
                    <field name="company_id" optional="show"/>
                    <field name="kpi_label" string="KPI"/>
                    <field name="kpi_value" string="Valor"/>
                    <field name="threshold" string="Umbral"/>
                    <field name="state" widget="badge" decoration-warning="state=='amarillo'" decoration-danger="state=='rojo'"/>
                </tree>
            </field>
        </record>

        <record id="action_sentinella_alert_list" model="ir.actions.act_window">
            <field name="name">Alertas</field>
            <field name="res_model">sentinella.alert</field>
            <field name="view_mode">list</field>
            <field name="context">{"search_default_group_by_date": 1}</field>
        </record>
    </data>
</odoo>
