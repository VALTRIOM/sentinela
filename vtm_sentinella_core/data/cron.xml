<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sentinella_daily" model="ir.cron">
            <field name="name">Sentinella — KPIs Diarios</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="model_id" ref="model_sentinella_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.compute_kpis()</field>
            <field name="active" eval="True"/>
            <field name="numbercall">-1</field>
        </record>
        <record id="cron_sentinella_monthly" model="ir.cron">
            <field name="name">Sentinella — Análisis de Costos Mensual</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="model_id" ref="model_sentinella_cost"/>
            <field name="state">code</field>
            <field name="code">model.compute_costs()</field>
            <field name="active" eval="True"/>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
